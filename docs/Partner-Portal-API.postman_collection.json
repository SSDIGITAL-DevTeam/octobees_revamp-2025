{
    "info": {
        "name": "Partner Portal API",
        "description": "Complete API collection for Partner Portal endpoints including authentication, dashboard, leads, and profile management",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{jwt_token}}",
                "type": "string"
            }
        ]
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:8080/api",
            "type": "string"
        },
        {
            "key": "jwt_token",
            "value": "",
            "type": "string"
        },
        {
            "key": "test_email",
            "value": "testpartner@example.com",
            "type": "string"
        },
        {
            "key": "test_password",
            "value": "password123",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Authentication",
            "item": [
                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.collectionVariables.set('jwt_token', jsonData.data.token);",
                                    "    console.log('JWT Token saved:', jsonData.data.token);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/v1/affiliate/auth/login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "v1",
                                "affiliate",
                                "auth",
                                "login"
                            ]
                        },
                        "description": "Login to get JWT token. Token is automatically saved to collection variable."
                    },
                    "response": []
                },
                {
                    "name": "Logout",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/v1/affiliate/auth/logout",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "v1",
                                "affiliate",
                                "auth",
                                "logout"
                            ]
                        },
                        "description": "Logout from the system"
                    },
                    "response": []
                },
                {
                    "name": "Change Password",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"oldPassword\": \"password123\",\n  \"newPassword\": \"newpassword123\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/v1/affiliate/auth/change-password",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "v1",
                                "affiliate",
                                "auth",
                                "change-password"
                            ]
                        },
                        "description": "Change user password"
                    },
                    "response": []
                },
                {
                    "name": "Forgot Password",
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{test_email}}\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/v1/affiliate/auth/forgot-password",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "v1",
                                "affiliate",
                                "auth",
                                "forgot-password"
                            ]
                        },
                        "description": "Request password reset"
                    },
                    "response": []
                }
            ],
            "description": "Authentication endpoints for login, logout, and password management"
        },
        {
            "name": "Dashboard",
            "item": [
                {
                    "name": "Get Dashboard Stats",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/v1/partner/dashboard/stats",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "v1",
                                "partner",
                                "dashboard",
                                "stats"
                            ]
                        },
                        "description": "Get partner dashboard statistics including total commission, pending commission, total leads, and conversion rate"
                    },
                    "response": []
                },
                {
                    "name": "Get Available Services",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/v1/partner/dashboard/services",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "v1",
                                "partner",
                                "dashboard",
                                "services"
                            ]
                        },
                        "description": "Get list of available services with commission rates"
                    },
                    "response": []
                },
                {
                    "name": "Get Commission History",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/v1/partner/dashboard/commissions?page=1&limit=10",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "v1",
                                "partner",
                                "dashboard",
                                "commissions"
                            ],
                            "query": [
                                {
                                    "key": "page",
                                    "value": "1",
                                    "description": "Page number"
                                },
                                {
                                    "key": "limit",
                                    "value": "10",
                                    "description": "Items per page"
                                }
                            ]
                        },
                        "description": "Get commission history with pagination"
                    },
                    "response": []
                },
                {
                    "name": "Get Recent Leads",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/v1/partner/dashboard/recent-leads?limit=5",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "v1",
                                "partner",
                                "dashboard",
                                "recent-leads"
                            ],
                            "query": [
                                {
                                    "key": "limit",
                                    "value": "5",
                                    "description": "Number of recent leads to fetch"
                                }
                            ]
                        },
                        "description": "Get recent leads for dashboard display"
                    },
                    "response": []
                }
            ],
            "description": "Dashboard endpoints for statistics and overview data"
        },
        {
            "name": "Leads",
            "item": [
                {
                    "name": "Get All Leads",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/v1/partner/leads?page=1&limit=10&status=Lead Created",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "v1",
                                "partner",
                                "leads"
                            ],
                            "query": [
                                {
                                    "key": "page",
                                    "value": "1",
                                    "description": "Page number"
                                },
                                {
                                    "key": "limit",
                                    "value": "10",
                                    "description": "Items per page"
                                },
                                {
                                    "key": "status",
                                    "value": "Lead Created",
                                    "description": "Filter by status (optional)",
                                    "disabled": true
                                }
                            ]
                        },
                        "description": "Get all leads with pagination and optional status filter"
                    },
                    "response": []
                },
                {
                    "name": "Get Lead by ID",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/v1/partner/leads/:leadId",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "v1",
                                "partner",
                                "leads",
                                ":leadId"
                            ],
                            "variable": [
                                {
                                    "key": "leadId",
                                    "value": "lead-id-here",
                                    "description": "Lead ID"
                                }
                            ]
                        },
                        "description": "Get detailed information about a specific lead"
                    },
                    "response": []
                },
                {
                    "name": "Create Lead",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"phone\": \"+62812345678\",\n  \"serviceId\": \"service-id-here\",\n  \"projectValue\": 50000000,\n  \"status\": \"Lead Created\",\n  \"remark\": \"Initial contact made via email\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/v1/partner/leads",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "v1",
                                "partner",
                                "leads"
                            ]
                        },
                        "description": "Create a new lead"
                    },
                    "response": []
                },
                {
                    "name": "Update Lead",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"status\": \"Follow-up\",\n  \"remark\": \"Sent proposal, waiting for response\",\n  \"projectValue\": 55000000\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/v1/partner/leads/:leadId",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "v1",
                                "partner",
                                "leads",
                                ":leadId"
                            ],
                            "variable": [
                                {
                                    "key": "leadId",
                                    "value": "lead-id-here",
                                    "description": "Lead ID"
                                }
                            ]
                        },
                        "description": "Update an existing lead"
                    },
                    "response": []
                },
                {
                    "name": "Delete Lead",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/v1/partner/leads/:leadId",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "v1",
                                "partner",
                                "leads",
                                ":leadId"
                            ],
                            "variable": [
                                {
                                    "key": "leadId",
                                    "value": "lead-id-here",
                                    "description": "Lead ID"
                                }
                            ]
                        },
                        "description": "Delete a lead"
                    },
                    "response": []
                }
            ],
            "description": "CRUD operations for managing partner leads"
        },
        {
            "name": "Profile",
            "item": [
                {
                    "name": "Get Profile",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/v1/partner/profile",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "v1",
                                "partner",
                                "profile"
                            ]
                        },
                        "description": "Get partner profile information"
                    },
                    "response": []
                },
                {
                    "name": "Update Profile",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"fullName\": \"Updated Partner Name\",\n  \"phone\": \"+62812345678\",\n  \"country\": \"Indonesia\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/v1/partner/profile",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "v1",
                                "partner",
                                "profile"
                            ]
                        },
                        "description": "Update partner profile information"
                    },
                    "response": []
                },
                {
                    "name": "Change Email",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"newEmail\": \"newemail@example.com\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/v1/partner/profile/change-email",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "v1",
                                "partner",
                                "profile",
                                "change-email"
                            ]
                        },
                        "description": "Request email change"
                    },
                    "response": []
                }
            ],
            "description": "Profile management endpoints"
        }
    ]
}