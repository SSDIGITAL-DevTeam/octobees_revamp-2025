# Server
NODE_ENV=development
PORT=8080
ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3006
BASE_URL=http://localhost:8080
API_PUBLIC_URL=http://localhost:8080
END_USER_URL=http://localhost:3000
PARTNER_PORTAL_URL=http://localhost:3002
AI_TRAINING_BASE_URL=http://localhost:3006

# Database
DATABASE_URL=mysql://digital_pa_user:replace-with-db-password@localhost:3306/digital_pa
DB_HOST=localhost
DB_PORT=3306
DB_USER=digital_pa_user
DB_PASSWORD=digital_pa_password
DB_NAME=digital_pa
# DB_SOCKET=/tmp/mysql.sock

# Auth
ACCESS_TOKEN_SECRET=replace-with-access-token-secret
REFRESH_TOKEN_SECRET=replace-with-refresh-token-secret
RESET_TOKEN_SECRET=replace-with-reset-token-secret
BCRYPT_ROUNDS=10
AFFILIATE_JWT_SECRET=replace-with-affiliate-jwt-secret
AFFILIATE_JWT_EXPIRES_IN=7d
AFFILIATE_RESET_TOKEN_TTL_MINUTES=30
AFFILIATE_CHANGE_PASSWORD_PATH=/setup-password
AFFILIATE_CHANGE_PASSWORD_TOKEN_TTL_HOURS=72
AFFILIATE_BCRYPT_COST=10

# AI / Assessment
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_SCREENING_BATCH_SIZE=5
EXAM_EXPIRY_HOURS=72
TRAINING_PDF_PAGES=10

# Scheduled Jobs
BATCH_SCREENING_CRON=*/5 * * * *
PERFORMANCE_EVAL_CRON=0 0 * * *

# Email / SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
SMTP_FROM="DIGITAL-PA <no-reply@example.com>"
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=DIGITAL-PA
SMTP_SENDER_EMAIL=no-reply@example.com
SMTP_SENDER_NAME=DIGITAL-PA
SMTP_SERVICE=
USER_EMAIL=no-reply@example.com
USER_PASSWORD=replace-with-email-password

# Recaptcha
RECAPTCHA_SECRET_KEY=replace-with-recaptcha-secret-key

# Seed / Admin Bootstrap
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASS=change-this-password
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=change-this-password
SUPER_ADMIN_ROLE=super_admin
SUPER_ADMIN_STATUS=active
SUPER_ADMIN_FEATURES=all
